# Judge provider for deepeval: "gemini" (default) or "anthropic".
# Switch to anthropic locally if the Gemini free-tier daily quota is exhausted.
JUDGE_PROVIDER=gemini

# Gemini API key — judge model for deepeval. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge model used when JUDGE_PROVIDER=gemini. Pin an explicit version — never
# a floating alias — so eval scores stay comparable across runs.
GEMINI_MODEL=gemini-3.6-flash

# Anthropic API key — used as the JUDGE_PROVIDER=anthropic fallback, and
# reserved for the model-under-test integration in generate_actual_output()
# (evals/test_eval.py) once that's wired up.
ANTHROPIC_API_KEY=

# Judge model used when JUDGE_PROVIDER=anthropic. Must be a model with
# thinking OFF by default. deepeval reads content[0].text unconditionally,
# so models that think by default (claude-opus-5, claude-sonnet-5) raise
# AttributeError on their leading ThinkingBlock.
ANTHROPIC_MODEL=claude-opus-4-8
