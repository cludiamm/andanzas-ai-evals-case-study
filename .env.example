# Anthropic API key — get one at https://console.anthropic.com
# Note: this is separate from a Claude Code / Claude Pro subscription.
ANTHROPIC_API_KEY=

# Judge model used by deepeval. Pin an explicit version — never a floating
# alias — so eval scores stay comparable across runs.
#
# Must be a model with thinking OFF by default. deepeval reads content[0].text
# unconditionally, so models that think by default (claude-opus-5, claude-sonnet-5)
# raise AttributeError on their leading ThinkingBlock.
ANTHROPIC_MODEL=claude-opus-4-8
